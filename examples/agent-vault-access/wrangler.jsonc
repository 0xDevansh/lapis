{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lapis-vault-agent",
  "compatibility_date": "2026-07-08",
  "compatibility_flags": ["nodejs_compat"],

  // Workers AI — provides the language model
  "ai": {
    "binding": "AI"
  },

  // The agent runs as a Durable Object so each session has persistent state
  "durable_objects": {
    "bindings": [
      {
        "class_name": "VaultAgent",
        "name": "VaultAgent"
      }
    ]
  },
  "migrations": [
    {
      "new_sqlite_classes": ["VaultAgent"],
      "tag": "v1"
    }
  ]

  // Secrets — set via `wrangler secret put` or in .dev.vars for local dev:
  //   LAPIS_URL        https://lapis.example.workers.dev
  //   LAPIS_EMAIL      vault-owner@example.com
  //   LAPIS_PASSWORD   your-lapis-password
  //   LAPIS_VAULT_ID   the vault ID from the Lapis web app
}
