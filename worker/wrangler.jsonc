{
  "name": "lapis",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },

  // Durable Objects
  "durable_objects": {
    "bindings": [
      {
        "name": "VAULT_COORDINATOR",
        "class_name": "VaultCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["VaultCoordinator"]
    }
  ],

  // R2 bucket for vault content
  "r2_buckets": [
    {
      "binding": "VAULT_BUCKET",
      "bucket_name": "lapis-vault"
    }
  ],

  // D1 database for auth + search
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lapis-db",
      "database_id": "8e4495ac-44df-4737-9290-60fd939b2418",
      "migrations_dir": "migrations"
    }
  ],

  // KV for session storage
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "de1a29f2802743ccb1ef339d60e7bcf8"
    }
  ],

  // Secrets (set via wrangler secret or .dev.vars)
  // BETTER_AUTH_SECRET
  // GOOGLE_CLIENT_ID
  // GOOGLE_CLIENT_SECRET
  // GITHUB_PAT_ENCRYPTION_KEY — secret for encrypting stored GitHub PATs (Slice 25)

  // Public URL for better-auth (cookies, redirects). Overridden locally by .dev.vars.
  "vars": {
    "BETTER_AUTH_URL": "https://lapis.dvenom.in"
  },

  "routes": [
    {
      "pattern": "lapis.dvenom.in",
      "zone_name": "dvenom.in",
      "custom_domain": true
    }
  ],

  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS"
  },

  // Artifacts — sealed Git history per vault
  "artifacts": [
    {
      "binding": "ARTIFACTS",
      "namespace": "lapis"
    }
  ]
}
