{
  "name": "worker",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "deploy": "wrangler deploy",
    "migrate": "wrangler d1 migrations apply lapis-db --local",
    "migrate:remote": "wrangler d1 migrations apply lapis-db --remote",
    "test": "vitest run --max-workers=1 --no-isolate",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@better-auth/kysely-adapter": "^1.6.16",
    "better-auth": "^1.6.16",
    "hono": "^4.7.11",
    "isomorphic-git": "^1.38.4",
    "kysely": "^0.29.2",
    "kysely-d1": "^0.4.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.12.4",
    "typescript": "^5.5.2",
    "vitest": "~3.2.0",
    "wrangler": "^4.97.0"
  }
}
